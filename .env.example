# SVAYIRO environment template.
# Copy this file to `.env` for local development.
# In production, add these values in your hosting provider environment settings.
# Never commit real production secrets.

# NODE_ENV controls runtime mode.
# Local: development
# Production: production
NODE_ENV=production

# PORT is the web server port.
# Render usually provides PORT automatically, but keeping 3000 is fine as a default.
PORT=3000

# ENABLE_HMR enables Vite hot module reload websocket.
# Production must stay false.
ENABLE_HMR=false

# VITE_HMR_PORT is used only when ENABLE_HMR=true.
VITE_HMR_PORT=24679

# APP_URL is the main hosted backend URL.
# Example: https://www.svayiro.com
APP_URL=https://www.svayiro.com

# APP_PUBLIC_URL is used by backend-generated public links, especially invoice links sent in WhatsApp.
# Example invoice: https://www.svayiro.com/invoice/INV-xxxx?token=...
APP_PUBLIC_URL=https://www.svayiro.com

# PUBLIC_APP_URL is a backend fallback URL used by map/OpenStreetMap identity.
# Keep same as APP_PUBLIC_URL.
PUBLIC_APP_URL=https://www.svayiro.com

# VITE_PUBLIC_APP_URL is exposed to the frontend for referral/share links.
# It must match your customer-facing website domain.
VITE_PUBLIC_APP_URL=https://www.svayiro.com

# DATABASE_URL is your production PostgreSQL connection string.
# Render/Railway/Neon/Supabase will provide it.
# Use sslmode=require when your provider requires SSL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# FORCE_DB_INIT forces db initialization even when tables exist.
# Keep false in production unless intentionally migrating/rebuilding.
FORCE_DB_INIT=false

# JWT_SECRET signs customer/admin login sessions.
# Required in production. Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_96_character_random_hex_secret

# SEED_ADMIN controls automatic owner/admin creation.
# Use true only for first setup or Docker startup seeding. Keep false after owner exists.
SEED_ADMIN=false

# SVAYIRO_ADMIN_PHONE is owner/admin phone for seed-admin.
SVAYIRO_ADMIN_PHONE=9876543210

# SVAYIRO_ADMIN_EMAIL is owner/admin email for seed-admin.
SVAYIRO_ADMIN_EMAIL=owner@svayiro.com

# SVAYIRO_ADMIN_NAME is owner/admin display name.
SVAYIRO_ADMIN_NAME=SVAYIRO Owner

# SVAYIRO_ADMIN_PASSWORD is owner/admin password created by seed-admin.
# Use a strong private password in production.
SVAYIRO_ADMIN_PASSWORD=replace_with_strong_owner_password

# SVAYIRO_DEFAULT_CATEGORIES is optional JSON used by scripts/seed-admin.mjs.
# Example:
# SVAYIRO_DEFAULT_CATEGORIES=[{"name":"Flours","slug":"flours"},{"name":"Vegetables","slug":"vegetables"}]

# SEARCH_USE_DELAY enables backend-search debounce behavior.
# true is recommended to reduce database/API load.
SEARCH_USE_DELAY=true

# SEARCH_DELAY_MS is the search debounce duration in milliseconds.
SEARCH_DELAY_MS=450

# GOOGLE_MAPS_PLATFORM_KEY is the server-side Google Maps key for accurate route distance.
# Leave blank to use free OpenStreetMap fallback.
GOOGLE_MAPS_PLATFORM_KEY=

# VITE_GOOGLE_MAPS_BROWSER_KEY is the browser-side Google Maps key for map picker.
# Leave blank to use Leaflet/OpenStreetMap.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# VITE_GOOGLE_MAPS_PLATFORM_KEY is a legacy frontend fallback key name.
# Usually leave blank.
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# NOMINATIM_USER_AGENT identifies your app to OpenStreetMap/Nominatim.
# Use a real domain and contact email for production.
NOMINATIM_USER_AGENT=SVAYIRO/1.0 (https://www.svayiro.com; contact: support@svayiro.com)

# GMAIL_USER sends customer registration and forgot-password OTP emails.
# Example: yourstore@gmail.com
GMAIL_USER=yourstore@gmail.com

# GMAIL_APP_PASSWORD is a Gmail App Password, not your Gmail account password.
# Create it from Google Account after enabling 2-Step Verification.
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# MAIL_FROM_NAME is shown as sender name in OTP emails.
MAIL_FROM_NAME=SVAYIRO

# SMTP_HOST is optional generic SMTP support.
SMTP_HOST=smtp.gmail.com

# SMTP_PORT is optional generic SMTP support.
SMTP_PORT=465

# SMTP_USER is optional fallback if not using GMAIL_USER.
SMTP_USER=

# SMTP_PASSWORD is optional fallback if not using GMAIL_APP_PASSWORD.
SMTP_PASSWORD=

# WHATSAPP_PHONE_NUMBER_ID is the Meta WhatsApp Cloud API phone number ID.
# Leave blank to use manual WhatsApp redirect with invoice link.
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_ACCESS_TOKEN is the Meta WhatsApp Cloud API access token.
# Leave blank until official WhatsApp API is configured.
WHATSAPP_ACCESS_TOKEN=

# WHATSAPP_GRAPH_VERSION is the Meta Graph API version.
WHATSAPP_GRAPH_VERSION=v20.0
